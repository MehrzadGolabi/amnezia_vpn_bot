#!/usr/bin/env python3
"""
vpnctl: manage AmneziaWG clients on a native amneziawg-go + awg-quick server.

The bot never runs it directly. systemd starts `vpnctl serve` as root for each
connection to its sockets (see scripts/provisioner/systemd/): the Unix socket
/run/vpnctl/vpnctl.sock on this host, and optionally a port on the Tailscale
address for a bot on another host. `serve` reads one JSON request, runs one of
the six commands below, and writes one JSON response.

Run by hand, every command prints one JSON object on stdout. Errors go to stderr
with a non-zero exit code: 2 for bad input, 3 for an unknown client (neither is
worth retrying), 4 for a caller that isn't allowed, 1 for anything else.

On-disk layout, shared with awg-add-client.sh / awg-del-client.sh:
  <CONF_DIR>/<INTERFACE>.conf        server config; each client is a [Peer] block
                                     whose first line is "# <name>"
  <CONF_DIR>/clients/<name>.conf     the client's config, as delivered
  <CONF_DIR>/clients/<name>.peer     the server-side [Peer] block (vpnctl only),
                                     kept so a disabled client can be re-enabled

Settings come from /etc/amnezia/vpnctl.conf (KEY=value lines), or the file named
by $VPNCTL_CONFIG. See vpnctl.conf.example.
"""

import argparse
import base64
import contextlib
import fcntl
import ipaddress
import json
import os
import re
import shlex
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import uuid
import zlib
from datetime import datetime, timezone

IDENTIFIER_REGEX = re.compile(r"^[a-zA-Z0-9_-]{1,64}$")
DEFAULT_CONFIG_PATH = "/etc/amnezia/vpnctl.conf"
DEFAULTS = {
    "INTERFACE": "awg1",
    "CONF_DIR": "/etc/amnezia/amneziawg",
    "AWG_BIN": "awg",
    "ENDPOINT_HOST": "",
    "ENDPOINT_PORT": "",
    "CLIENT_DNS": "1.1.1.1, 9.9.9.9",
    "CLIENT_MTU": "1280",
    "CLIENT_ALLOWED_IPS": "0.0.0.0/0, ::/0",
    "PERSISTENT_KEEPALIVE": "25",
    "ALLOWED_CLIENTS": "",
}
# Every obfuscation line in the server's [Interface] is copied into client configs,
# exactly like awg-add-client.sh, so the values that must match (H1-H4, S1-S4,
# HeaderProtectionKey, RandomTrailers) always do.
OBFUSCATION_LINE = re.compile(
    r"^(Jc|Jmin|Jmax|S[1-4]|H[1-4]|I[1-5]|HeaderProtectionKey|ContentPaddingAddition|"
    r"RekeyAfterTime|RekeyTimeout|RejectAfterTime|KeepaliveTimeout|MaxHandshakeAttempts|"
    r"RandomTrailers|DisableCookies) *="
)
SECTION_HEADER = re.compile(r"^\s*\[[A-Za-z]+\]\s*$")
ACTIVE_HANDSHAKE_SECONDS = 180


class VpnctlError(Exception):
    exit_code = 1


class InvalidInput(VpnctlError):
    exit_code = 2


class NotFound(VpnctlError):
    exit_code = 3


class Refused(VpnctlError):
    exit_code = 4


def validate_identifier(name: str, value: str) -> str:
    if not isinstance(value, str) or not IDENTIFIER_REGEX.match(value):
        raise InvalidInput(f"Invalid {name}: {value!r}. Must match {IDENTIFIER_REGEX.pattern}")
    return value


def validate_uuid(value: str) -> str:
    try:
        return str(uuid.UUID(value))
    except ValueError:
        raise InvalidInput(f"Invalid UUID: {value!r}")


# --- Amnezia vpn:// codec (Qt qCompress + URL-safe base64) ---

def encode_vpn_url(config_text: str) -> str:
    data = config_text.encode("utf-8")
    compressed = struct.pack(">I", len(data)) + zlib.compress(data, 8)
    return "vpn://" + base64.urlsafe_b64encode(compressed).rstrip(b"=").decode("ascii")


def decode_vpn_url(vpn_url: str) -> str:
    raw = vpn_url.strip()
    if raw.startswith("vpn://"):
        raw = raw[6:]
    raw += "=" * ((4 - len(raw) % 4) % 4)
    try:
        data = base64.urlsafe_b64decode(raw.encode("ascii"))
        out = zlib.decompress(data[4:])
        if len(out) == struct.unpack(">I", data[:4])[0]:
            return out.decode("utf-8")
    except Exception:
        pass
    return ""


# --- Settings and helpers ---

def load_settings() -> dict:
    cfg = dict(DEFAULTS)
    path = os.environ.get("VPNCTL_CONFIG", DEFAULT_CONFIG_PATH)
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip().upper()] = v.strip().strip('"').strip("'")
    validate_identifier("INTERFACE", cfg["INTERFACE"])
    return cfg


class Server:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.iface = cfg["INTERFACE"]
        self.conf_dir = cfg["CONF_DIR"]
        self.conf_path = os.path.join(self.conf_dir, f"{self.iface}.conf")
        self.clients_dir = os.path.join(self.conf_dir, "clients")
        self.awg = shlex.split(cfg["AWG_BIN"])

    # -- awg binary --
    def awg_run(self, *args: str, input_text: str = None) -> str:
        res = subprocess.run([*self.awg, *args], input=input_text, capture_output=True, text=True)
        if res.returncode != 0:
            raise VpnctlError(f"awg {' '.join(args[:2])} failed: {res.stderr.strip() or res.stdout.strip()}")
        return res.stdout.strip()

    def awg_set_peer(self, pub: str, psk: str, allowed_ips: str) -> None:
        with tempfile.NamedTemporaryFile("w", dir=self.conf_dir, prefix=".psk-", delete=False) as f:
            os.chmod(f.name, 0o600)
            f.write(psk + "\n")
            psk_path = f.name
        try:
            self.awg_run("set", self.iface, "peer", pub, "preshared-key", psk_path, "allowed-ips", allowed_ips)
        finally:
            os.remove(psk_path)

    def awg_remove_peer(self, pub: str) -> None:
        self.awg_run("set", self.iface, "peer", pub, "remove")

    # -- files --
    def read_conf(self) -> str:
        try:
            with open(self.conf_path, encoding="utf-8") as f:
                return f.read()
        except FileNotFoundError:
            raise VpnctlError(f"Server config not found: {self.conf_path}")

    def client_path(self, name: str, ext: str) -> str:
        return os.path.join(self.clients_dir, f"{name}.{ext}")

    def read_client_file(self, name: str, ext: str):
        try:
            with open(self.client_path(name, ext), encoding="utf-8") as f:
                return f.read()
        except FileNotFoundError:
            return None

    @contextlib.contextmanager
    def lock(self):
        os.makedirs(self.clients_dir, mode=0o700, exist_ok=True)
        with open(os.path.join(self.conf_dir, ".vpnctl.lock"), "w") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            yield


def write_private(path: str, text: str) -> None:
    """Atomically replace path with text, readable by root only."""
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.remove(tmp)
        raise


def split_sections(text: str) -> list:
    """Split a config into sections; each is (header, list_of_lines incl. header).
    Lines before the first header are returned under header None."""
    sections = []
    current = [None, []]
    for line in text.splitlines(keepends=True):
        if SECTION_HEADER.match(line):
            sections.append(current)
            current = [line.strip(), [line]]
        else:
            current[1].append(line)
    sections.append(current)
    return [(h, lines) for h, lines in sections if h is not None or lines]


def interface_lines(conf: str) -> list:
    for header, lines in split_sections(conf):
        if header == "[Interface]":
            return [l.rstrip("\n") for l in lines[1:]]
    raise VpnctlError("No [Interface] section in server config")


def get_value(lines: list, key: str):
    pattern = re.compile(rf"^\s*{key}\s*=\s*(.+?)\s*$")
    for line in lines:
        m = pattern.match(line)
        if m:
            return m.group(1)
    return None


def peer_name(lines: list):
    if len(lines) > 1:
        m = re.match(r"^#\s*(\S+)\s*$", lines[1].rstrip("\n"))
        if m:
            return m.group(1)
    return None


def find_peer(conf: str, name: str):
    """Return (block_text, public_key) of the [Peer] named `# name`, or (None, None)."""
    for header, lines in split_sections(conf):
        if header == "[Peer]" and peer_name(lines) == name:
            return "".join(lines), get_value(lines, "PublicKey")
    return None, None


def without_peer(conf: str, name: str) -> str:
    kept = [lines for header, lines in split_sections(conf)
            if not (header == "[Peer]" and peer_name(lines) == name)]
    return "".join("".join(lines) for lines in kept)


def used_addresses(srv: Server, conf: str, include_saved: bool = True) -> set:
    used = set()
    texts = [conf]
    if include_saved and os.path.isdir(srv.clients_dir):
        for fn in os.listdir(srv.clients_dir):
            if fn.endswith(".peer"):
                with open(os.path.join(srv.clients_dir, fn), encoding="utf-8") as f:
                    texts.append(f.read())
    for text in texts:
        for m in re.finditer(r"^\s*AllowedIPs\s*=\s*(.+)$", text, re.MULTILINE):
            for part in m.group(1).split(","):
                with contextlib.suppress(ValueError):
                    used.add(ipaddress.ip_interface(part.strip()).ip)
    return used


def detect_endpoint_host() -> str:
    route = subprocess.run(["ip", "-4", "route", "show", "table", "main", "default"],
                           capture_output=True, text=True).stdout.split()
    if "dev" in route:
        dev = route[route.index("dev") + 1]
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", dev, "scope", "global"],
                             capture_output=True, text=True).stdout.split()
        if "inet" in out:
            return out[out.index("inet") + 1].split("/")[0]
    raise VpnctlError("Could not detect the public IP; set ENDPOINT_HOST in vpnctl.conf")


def peer_result(name: str, config_text: str, **extra) -> dict:
    return {
        "status": "success",
        "peer_id": name,
        "label": name,
        "filename": f"{name}.conf",
        "config_b64": base64.b64encode(config_text.encode("utf-8")).decode("ascii"),
        "vpn_url": encode_vpn_url(config_text),
        **extra,
    }


# --- Commands ---

def cmd_create_peer(args, srv: Server) -> dict:
    validate_uuid(args.subscription_id)
    name = validate_identifier("label", args.label)

    with srv.lock():
        existing = srv.read_client_file(name, "conf")
        if existing is not None:
            # A retried job must not create a second peer for the same subscription.
            return peer_result(name, existing, existing=True)

        conf = srv.read_conf()
        iface = interface_lines(conf)
        address = get_value(iface, "Address")
        port = srv.cfg["ENDPOINT_PORT"] or get_value(iface, "ListenPort")
        server_priv = get_value(iface, "PrivateKey")
        if not address or not port or not server_priv:
            raise VpnctlError("Server [Interface] needs Address, ListenPort and PrivateKey")

        server_if = ipaddress.ip_interface(address.split(",")[0].strip())
        used = used_addresses(srv, conf) | {server_if.ip}
        client_ip = next((h for h in server_if.network.hosts() if h not in used), None)
        if client_ip is None:
            raise VpnctlError(f"Subnet {server_if.network} is full")

        priv = srv.awg_run("genkey")
        pub = srv.awg_run("pubkey", input_text=priv + "\n")
        psk = srv.awg_run("genpsk")
        server_pub = srv.awg_run("pubkey", input_text=server_priv + "\n")
        endpoint_host = srv.cfg["ENDPOINT_HOST"] or detect_endpoint_host()
        if ":" in endpoint_host and not endpoint_host.startswith("["):
            endpoint_host = f"[{endpoint_host}]"

        peer_block = (
            f"[Peer]\n"
            f"# {name}\n"
            f"PublicKey = {pub}\n"
            f"PresharedKey = {psk}\n"
            f"AllowedIPs = {client_ip}/32\n"
        )
        obfuscation = "\n".join(l.strip() for l in iface if OBFUSCATION_LINE.match(l.strip()))
        client_conf = (
            f"[Interface]\n"
            f"PrivateKey = {priv}\n"
            f"Address = {client_ip}/32\n"
            f"DNS = {srv.cfg['CLIENT_DNS']}\n"
            f"MTU = {srv.cfg['CLIENT_MTU']}\n"
            f"{obfuscation}\n"
            f"\n"
            f"[Peer]\n"
            f"PublicKey = {server_pub}\n"
            f"PresharedKey = {psk}\n"
            f"AllowedIPs = {srv.cfg['CLIENT_ALLOWED_IPS']}\n"
            f"Endpoint = {endpoint_host}:{port}\n"
            f"PersistentKeepalive = {srv.cfg['PERSISTENT_KEEPALIVE']}\n"
        )

        # Apply live first: if the interface is down we fail before touching any file.
        srv.awg_set_peer(pub, psk, f"{client_ip}/32")
        try:
            write_private(srv.client_path(name, "peer"), peer_block)
            write_private(srv.conf_path, conf.rstrip("\n") + "\n\n" + peer_block)
            write_private(srv.client_path(name, "conf"), client_conf)
        except BaseException:
            with contextlib.suppress(Exception):
                srv.awg_remove_peer(pub)
            raise

    return peer_result(name, client_conf, address=f"{client_ip}/32", existing=False)


def cmd_disable_peer(args, srv: Server) -> dict:
    name = validate_identifier("peer_id", args.peer_id)
    with srv.lock():
        conf = srv.read_conf()
        block, pub = find_peer(conf, name)
        if block is None:
            found = srv.read_client_file(name, "peer") is not None
            return {"status": "success", "peer_id": name, "found": found, "enabled": False}
        if srv.read_client_file(name, "peer") is None:
            # Created by awg-add-client.sh: keep the block so enable-peer can restore it.
            write_private(srv.client_path(name, "peer"), block.rstrip("\n") + "\n")
        write_private(srv.conf_path, without_peer(conf, name))
        if pub:
            srv.awg_remove_peer(pub)
    return {"status": "success", "peer_id": name, "found": True, "enabled": False}


def cmd_enable_peer(args, srv: Server) -> dict:
    name = validate_identifier("peer_id", args.peer_id)
    with srv.lock():
        conf = srv.read_conf()
        block, _ = find_peer(conf, name)
        if block is None:
            block = srv.read_client_file(name, "peer")
            if block is None:
                raise NotFound(f"No client named {name}")
            lines = block.splitlines()
            # awg-add-client.sh can't see disabled peers and may have handed this address out since.
            addr = ipaddress.ip_interface(get_value(lines, "AllowedIPs").split(",")[0].strip()).ip
            if addr in used_addresses(srv, conf, include_saved=False):
                raise VpnctlError(f"{addr} is now used by another peer; remove {name} and create a new one")
            write_private(srv.conf_path, conf.rstrip("\n") + "\n\n" + block.rstrip("\n") + "\n")
        lines = block.splitlines()
        srv.awg_set_peer(get_value(lines, "PublicKey"), get_value(lines, "PresharedKey"),
                         get_value(lines, "AllowedIPs"))
    return {"status": "success", "peer_id": name, "found": True, "enabled": True}


def cmd_remove_peer(args, srv: Server) -> dict:
    name = validate_identifier("peer_id", args.peer_id)
    with srv.lock():
        conf = srv.read_conf()
        block, pub = find_peer(conf, name)
        if block is not None:
            write_private(srv.conf_path, without_peer(conf, name))
        else:
            saved = srv.read_client_file(name, "peer")
            pub = get_value(saved.splitlines(), "PublicKey") if saved else None
        if pub:
            srv.awg_remove_peer(pub)
        found = pub is not None or srv.read_client_file(name, "conf") is not None
        for ext in ("conf", "peer"):
            with contextlib.suppress(FileNotFoundError):
                os.remove(srv.client_path(name, ext))
    return {"status": "success", "peer_id": name, "found": found}


def _awg_show_table(srv: Server, field: str) -> dict:
    out = srv.awg_run("show", srv.iface, field)
    table = {}
    for line in out.splitlines():
        parts = line.split()
        if parts:
            table[parts[0]] = parts[1:]
    return table


def cmd_peer_status(args, srv: Server) -> dict:
    name = validate_identifier("peer_id", args.peer_id)
    conf = srv.read_conf()
    block, pub = find_peer(conf, name)
    enabled = block is not None
    if pub is None:
        saved = srv.read_client_file(name, "peer")
        pub = get_value(saved.splitlines(), "PublicKey") if saved else None
    result = {"status": "success", "peer_id": name, "exists": pub is not None, "enabled": enabled,
              "is_active": False, "last_handshake": None, "bytes_received": 0, "bytes_sent": 0}
    if pub is None or not enabled:
        return result

    handshakes = _awg_show_table(srv, "latest-handshakes")
    transfer = _awg_show_table(srv, "transfer")
    ts = int(handshakes.get(pub, ["0"])[0] or 0)
    if ts > 0:
        last = datetime.fromtimestamp(ts, tz=timezone.utc)
        result["last_handshake"] = last.isoformat()
        result["is_active"] = (datetime.now(timezone.utc) - last).total_seconds() < ACTIVE_HANDSHAKE_SECONDS
    rx_tx = transfer.get(pub, ["0", "0"])
    result["bytes_received"], result["bytes_sent"] = int(rx_tx[0]), int(rx_tx[1])
    result["live"] = pub in handshakes
    return result


def cmd_get_config(args, srv: Server) -> dict:
    name = validate_identifier("peer_id", args.peer_id)
    text = srv.read_client_file(name, "conf")
    if text is None:
        raise NotFound(f"No client config for {name}")
    return peer_result(name, text)


def cmd_encode(args, srv=None):
    # Reads stdin, not a path: run as root, a path argument would read any file.
    print(encode_vpn_url(sys.stdin.read()))


def cmd_decode(args, srv=None):
    decoded = decode_vpn_url(args.url)
    if not decoded:
        raise InvalidInput("Could not decode vpn:// URL")
    print(decoded)


# --- serve: one request from the bot per connection ---

# The only commands a connection can run, and the arguments each one takes.
SERVE_COMMANDS = {
    "create-peer": (cmd_create_peer, {"subscription_id", "label"}),
    "disable-peer": (cmd_disable_peer, {"peer_id"}),
    "enable-peer": (cmd_enable_peer, {"peer_id"}),
    "remove-peer": (cmd_remove_peer, {"peer_id"}),
    "peer-status": (cmd_peer_status, {"peer_id"}),
    "get-config": (cmd_get_config, {"peer_id"}),
}
MAX_REQUEST_BYTES = 4096
READ_TIMEOUT_SECONDS = 10


def connection():
    """The socket systemd handed us as stdin, or None when stdin is a pipe or file."""
    if not stat.S_ISSOCK(os.fstat(0).st_mode):
        return None
    return socket.socket(fileno=os.dup(0))


def check_caller(sock, cfg: dict) -> None:
    """A Unix-socket caller got past the socket's file permissions. A TCP caller must
    come from an address in ALLOWED_CLIENTS: the bot host's Tailscale IP."""
    if sock is None or sock.family == socket.AF_UNIX:
        return
    try:
        peer = ipaddress.ip_address(sock.getpeername()[0])
    except (OSError, ValueError):
        raise Refused("Cannot tell who is calling")
    if getattr(peer, "ipv4_mapped", None):
        peer = peer.ipv4_mapped
    allowed = set()
    for part in cfg["ALLOWED_CLIENTS"].split(","):
        with contextlib.suppress(ValueError):
            allowed.add(ipaddress.ip_address(part.strip()))
    if peer not in allowed:
        raise Refused(f"{peer} is not in ALLOWED_CLIENTS")


def read_request(sock) -> dict:
    if sock is None:
        raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    else:
        sock.settimeout(READ_TIMEOUT_SECONDS)
        raw = b""
        try:
            while b"\n" not in raw and len(raw) <= MAX_REQUEST_BYTES:
                chunk = sock.recv(MAX_REQUEST_BYTES + 1 - len(raw))
                if not chunk:
                    break
                raw += chunk
        except socket.timeout:
            raise InvalidInput("Timed out reading the request")
    if len(raw) > MAX_REQUEST_BYTES:
        raise InvalidInput("Request too large")
    try:
        request = json.loads(raw.split(b"\n", 1)[0].decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise InvalidInput("Request is not JSON")
    if not isinstance(request, dict) or not isinstance(request.get("args", {}), dict):
        raise InvalidInput("Request must be an object with an args object")
    return request


def handle(request: dict, cfg: dict) -> dict:
    command = request.get("command")
    if command not in SERVE_COMMANDS:
        raise InvalidInput(f"Unknown command: {command!r}")
    func, expected = SERVE_COMMANDS[command]
    args = request.get("args", {})
    if set(args) != expected or not all(isinstance(v, str) for v in args.values()):
        raise InvalidInput(f"{command} takes exactly: {', '.join(sorted(expected))}")
    return func(argparse.Namespace(**args), Server(cfg))


def cmd_serve(args, srv=None):
    """Answer one request. Errors go back in the response and the process still exits 0,
    so systemd doesn't keep a failed unit for every bad request."""
    try:
        sock = connection()
        cfg = load_settings()
        # Read the (size-capped) request before refusing anyone: closing with unread
        # data resets the connection, and the caller would never see why.
        try:
            request, bad_request = read_request(sock), None
        except InvalidInput as e:
            request, bad_request = None, e
        check_caller(sock, cfg)
        if bad_request:
            raise bad_request
        response = {"exit_code": 0, "result": handle(request, cfg)}
    except VpnctlError as e:
        response = {"exit_code": e.exit_code, "error": str(e)}
    except OSError as e:
        response = {"exit_code": 1, "error": str(e)}
    if response["exit_code"]:
        sys.stderr.write(f"vpnctl serve: {response['error']}\n")
    sys.stdout.write(json.dumps(response) + "\n")
    sys.stdout.flush()


def main():
    parser = argparse.ArgumentParser(description="AmneziaWG client provisioning for a native awg-quick server")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("create-peer")
    p.add_argument("--subscription-id", required=True)
    p.add_argument("--label", required=True)
    p.set_defaults(func=cmd_create_peer)

    for cmd, func in (("disable-peer", cmd_disable_peer), ("enable-peer", cmd_enable_peer),
                      ("remove-peer", cmd_remove_peer), ("peer-status", cmd_peer_status),
                      ("get-config", cmd_get_config)):
        p = sub.add_parser(cmd)
        p.add_argument("--peer-id", required=True)
        p.set_defaults(func=func)

    p = sub.add_parser("encode", help="Read a .conf on stdin and print its vpn:// key")
    p.set_defaults(func=cmd_encode, raw=True)

    p = sub.add_parser("decode")
    p.add_argument("-u", "--url", required=True, help="vpn:// URL")
    p.set_defaults(func=cmd_decode, raw=True)

    p = sub.add_parser("serve", help="Answer one request on stdin (started by systemd)")
    p.set_defaults(func=cmd_serve, raw=True)

    args = parser.parse_args()
    try:
        if getattr(args, "raw", False):
            args.func(args)
            return
        result = args.func(args, Server(load_settings()))
        print(json.dumps(result))
    except VpnctlError as e:
        sys.stderr.write(f"Error: {e}\n")
        sys.exit(e.exit_code)
    except OSError as e:
        sys.stderr.write(f"Error: {e}\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
