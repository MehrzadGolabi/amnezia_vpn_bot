#!/usr/bin/env python3
"""Ask vpnctl for the status of a client that doesn't exist, the way the bot does.

    vpnctl-check                   through /run/vpnctl/vpnctl.sock on this host
    vpnctl-check <host> [port]     over Tailscale to another VPN host (port 7391), with
                                   VPNCTL_TOKEN from the environment or the bot's .env

Prints vpnctl's answer. "exists": false means the connection and vpnctl work.
"""
import json
import os
import socket
import sys

ENV_FILE = "/opt/amnezia_vpn_bot/.env"


def token() -> str:
    if os.environ.get("VPNCTL_TOKEN"):
        return os.environ["VPNCTL_TOKEN"]
    found = []
    try:
        with open(ENV_FILE, encoding="utf-8") as f:
            for line in f:
                if line.startswith("VPNCTL_TOKEN="):
                    found.append(line.split("=", 1)[1].strip().strip('"').strip("'"))
    except OSError:
        pass
    if len(found) > 1:
        print(f"warning: {ENV_FILE} has {len(found)} VPNCTL_TOKEN lines; the bot uses the last one, "
              "and so does this check. Keep one, shared by every VPN host.", file=sys.stderr)
    # The last line wins, as it does for the bot (python-dotenv).
    return found[-1] if found else ""


def main(argv):
    body = {"command": "peer-status", "args": {"peer_id": "vpnctl-check"}}
    if argv:
        body["token"] = token()
    request = json.dumps(body).encode() + b"\n"
    if argv:
        sock = socket.create_connection((argv[0], int(argv[1]) if len(argv) > 1 else 7391), timeout=15)
    else:
        sock = socket.socket(socket.AF_UNIX)
        sock.settimeout(15)
        sock.connect("/run/vpnctl/vpnctl.sock")
    with sock:
        sock.sendall(request)
        sock.shutdown(socket.SHUT_WR)
        out = b""
        while chunk := sock.recv(65536):
            out += chunk
    print(out.decode().strip())
    return 0 if json.loads(out).get("exit_code") == 0 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
