#!/usr/bin/env python3
"""Forced command for the bot's SSH key on a VPN host.

authorized_keys runs this instead of whatever the client asked for, so the key
can only run the vpnctl subcommands the bot uses. No shell, no other programs.
The requested command is in SSH_ORIGINAL_COMMAND, for example:

    sudo -n /usr/local/sbin/vpnctl peer-status --peer-id user_1_abcd1234_de-1
"""
import os
import re
import shlex
import sys

VPNCTL = "/usr/local/sbin/vpnctl"
SUDO = "/usr/bin/sudo"
PREFIXES = (["sudo", "-n", VPNCTL], [VPNCTL], ["vpnctl"])
IDENTIFIER = re.compile(r"^[a-zA-Z0-9_-]{1,64}$")
UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
PEER_COMMANDS = {"disable-peer", "enable-peer", "remove-peer", "peer-status", "get-config"}


def allowed(args):
    if len(args) == 5 and args[0] == "create-peer" and args[1] == "--subscription-id" and args[3] == "--label":
        return bool(UUID.match(args[2]) and IDENTIFIER.match(args[4]))
    if len(args) == 3 and args[0] in PEER_COMMANDS and args[1] == "--peer-id":
        return bool(IDENTIFIER.match(args[2]))
    return False


def main():
    try:
        words = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
    except ValueError:
        words = []
    args = None
    for prefix in PREFIXES:
        if words[:len(prefix)] == prefix:
            args = words[len(prefix):]
            break
    if args is None or not allowed(args):
        print("vpnctl-ssh: command not allowed", file=sys.stderr)
        return 2
    os.execve(SUDO, [SUDO, "-n", VPNCTL, *args], {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"})


if __name__ == "__main__":
    sys.exit(main())
