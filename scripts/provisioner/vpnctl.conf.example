# /etc/amnezia/vpnctl.conf - settings for /usr/local/sbin/vpnctl on the VPN host.
# vpnctl reads the server's keys, port, subnet and every AWG 3.1 obfuscation line
# straight from <CONF_DIR>/<INTERFACE>.conf, so there is nothing to copy here.

# The awg-quick interface the bot manages (awg-quick@awg1).
INTERFACE=awg1
CONF_DIR=/etc/amnezia/amneziawg

# Public address clients connect to. Leave empty to use the IP of the default route's
# interface, the same way awg-add-client.sh does. Set it if the server is behind NAT
# or you want clients to use a hostname.
ENDPOINT_HOST=
# Defaults to the server's ListenPort.
ENDPOINT_PORT=

# Written into every client config.
CLIENT_DNS=1.1.1.1, 9.9.9.9
CLIENT_MTU=1280
CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
PERSISTENT_KEEPALIVE=25

# The awg binary from amneziawg-tools 3.1.
AWG_BIN=awg
