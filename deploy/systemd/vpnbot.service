[Unit]
Description=AmneziaWG VPN bot (Telegram bot, provisioning worker and scheduler)
After=network-online.target awg-quick@awg1.service
Wants=network-online.target

[Service]
User=vpn-provisioner
Group=vpn-provisioner
WorkingDirectory=/opt/amnezia_vpn_bot
Environment=PYTHONPATH=/opt/amnezia_vpn_bot PYTHONUNBUFFERED=1
ExecStartPre=/opt/amnezia_vpn_bot/.venv/bin/alembic upgrade head
ExecStart=/opt/amnezia_vpn_bot/.venv/bin/python -m src.app.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
