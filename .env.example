# Settings for the bot, worker and scheduler. Every setting: docs/CONFIGURATION.md

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ1234567
ADMIN_TELEGRAM_IDS=123456789
ADMIN_CHAT_ID=123456789

# Database. Without Docker, use SQLite:
#   DATABASE_URL=sqlite+aiosqlite:////opt/amnezia_vpn_bot/data/bot.db
# With Docker, use the Postgres container (keep the password in sync):
POSTGRES_USER=vpn_bot
POSTGRES_PASSWORD=vpn_bot_secret
POSTGRES_DB=vpn_bot
DATABASE_URL=postgresql+asyncpg://vpn_bot:vpn_bot_secret@postgres:5432/vpn_bot

# Provisioning: local (no Docker), ssh (Docker), or mock (fake configs, no server)
PROVISIONER_MODE=mock
VPNCTL_COMMAND=sudo -n /usr/local/sbin/vpnctl
PROVISIONING_JOB_POLL_SECONDS=5

# Subscriptions
EXPIRY_CHECK_INTERVAL_SECONDS=300
REMINDER_DAYS_BEFORE_EXPIRY=7,3,1
PEER_REMOVAL_GRACE_DAYS=30
CONFIG_REDELIVERY_LIMIT=3
PAYMENT_INSTRUCTIONS_EN=Please transfer payment to card 1234-5678-9012-3456 and upload your receipt.
PAYMENT_INSTRUCTIONS_FA=لطفا مبلغ را به کارت ۶۰۳۷۹۹۱۸۰۰۰۰۰۰۰۰ واریز نموده و رسید را ارسال فرمایید.

# One group per location customers can buy. HOST, PORT, USERNAME and the SSH
# settings are for reaching the server over SSH. With PROVISIONER_MODE=local,
# leave HOST out for the server the bot runs on (see docs/NATIVE_SETUP.md).
VPN_SERVER_MAIN_1_SLUG=main-1
VPN_SERVER_MAIN_1_COUNTRY_CODE=DE
VPN_SERVER_MAIN_1_DISPLAY_NAME=Germany
VPN_SERVER_MAIN_1_ENABLED=true
VPN_SERVER_MAIN_1_HOST=host.docker.internal
VPN_SERVER_MAIN_1_PORT=22
VPN_SERVER_MAIN_1_USERNAME=vpn-provisioner
VPN_SERVER_MAIN_1_SSH_PRIVATE_KEY_PATH=/app/secrets/id_ed25519
# The server's SSH host key must be listed here (see docs/DOCKER_SETUP.md).
VPN_SERVER_MAIN_1_SSH_KNOWN_HOSTS_PATH=/app/secrets/known_hosts

APP_ENV=production
LOG_LEVEL=INFO
